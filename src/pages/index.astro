---
import PremiumLayout from '../layouts/PremiumLayout.astro';
import FeaturedHero from '../components/premium/FeaturedHero.astro';
import ThumbCard from '../components/premium/ThumbCard.astro';
import PromoBanner from '../components/premium/PromoBanner.astro';
import { loadArticles } from '../lib/articles.js';

const { published, upcoming, temas } = await loadArticles();

// Destaque: artigo mais recente publicado; sem publicados, o próximo agendado
const featured = published[0] ?? upcoming[0];
const grid = [...published.slice(1), ...upcoming];

// Perguntas da home: aparecem na página e na marcação FAQPage (JSON-LD)
const perguntas = [
  {
    pergunta: 'O que é o Mente Leve?',
    resposta: 'O Mente Leve é um blog informativo sobre ansiedade, estresse, sono, meditação e bem-estar mental. Os textos são educativos e não substituem consulta com profissional de saúde.',
  },
  {
    pergunta: 'Os artigos substituem um médico ou psicólogo?',
    resposta: 'Não. Os artigos têm caráter informativo. Para sintomas que persistem ou para avaliação individual, procure um médico, um psicólogo ou uma unidade de saúde do SUS. Em situação de risco, ligue 192 (SAMU).',
  },
  {
    pergunta: 'Quando procurar ajuda para ansiedade ou estresse?',
    resposta: 'Procure ajuda quando os sintomas duram semanas, atrapalham o trabalho, o sono ou os relacionamentos. Um profissional de saúde pode avaliar a situação e indicar o cuidado mais adequado.',
  },
  {
    pergunta: 'Onde encontro apoio emocional imediato?',
    resposta: 'O CVV (Centro de Valorização da Vida) atende gratuitamente pelo telefone 188, 24 horas por dia, e também oferece atendimento por outros canais.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: perguntas.map(({ pergunta, resposta }) => ({
    '@type': 'Question',
    name: pergunta,
    acceptedAnswer: { '@type': 'Answer', text: resposta },
  })),
};
---

<PremiumLayout
  title="Artigos sobre ansiedade, estresse e sono"
  description="Blog Mente Leve: artigos informativos sobre ansiedade, estresse, sono, meditação e bem-estar mental, com linguagem simples e fontes confiáveis."
>
  {featured && <FeaturedHero article={featured} />}

  <section class="mx-auto max-w-3xl px-5 pt-16 lg:px-8">
    <p class="text-lg leading-relaxed text-ink-700">
      O Mente Leve reúne artigos informativos sobre ansiedade, estresse, sono e bem-estar mental. Segundo a Organização Mundial da Saúde, mais de 1 bilhão de pessoas no mundo vivem com algum transtorno mental, de acordo com o seu relatório de 2022 (<a class="underline hover:text-brand-600" href="https://www.who.int/news-room/fact-sheets/detail/mental-disorders" rel="noopener" target="_blank">fonte: OMS</a>). Aqui você encontra explicações claras, sinais de alerta e práticas simples para o dia a dia, sempre com fontes e com orientação para procurar ajuda profissional quando necessário.
    </p>
  </section>

  <section id="artigos" class="mx-auto max-w-7xl px-5 pt-20 lg:px-8">
    <div class="flex flex-col gap-8 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="text-xs font-bold uppercase tracking-[0.2em] text-brand-500">Biblioteca</p>
        <h2 class="mt-2 text-4xl font-semibold text-ink-900">Leituras para respirar melhor</h2>
      </div>
      <div class="flex flex-wrap gap-2" role="group" aria-label="Filtrar por tema" data-filter-group>
        <button
          type="button"
          data-filter="all"
          aria-pressed="true"
          class="filter-chip rounded-full border border-brand-200 bg-brand-600 px-4 py-2 text-sm font-semibold text-white transition"
        >
          Todos
        </button>
        {temas.map(tema => (
          <button
            type="button"
            data-filter={tema}
            aria-pressed="false"
            class="filter-chip rounded-full border border-brand-200 bg-white px-4 py-2 text-sm font-semibold text-brand-700 transition hover:border-brand-500"
          >
            {tema}
          </button>
        ))}
      </div>
    </div>

    <div class="mt-12 grid gap-8 sm:grid-cols-2 xl:grid-cols-3" data-grid>
      {grid.map(article => (
        <div data-tema={article.tema}>
          <ThumbCard article={article} />
        </div>
      ))}
    </div>

    <p class="mt-14 text-center text-sm text-ink-500">
      {published.length} artigo(s) publicado(s) · Conteúdo informativo, não substitui orientação profissional.
    </p>
  </section>

  <section class="mx-auto max-w-3xl px-5 pt-24 lg:px-8" aria-labelledby="perguntas">
    <h2 id="perguntas" class="text-3xl font-semibold text-ink-900">Perguntas frequentes</h2>
    <dl class="mt-8 space-y-8">
      {perguntas.map(({ pergunta, resposta }) => (
        <div>
          <dt><h3 class="text-xl font-semibold text-ink-900">{pergunta}</h3></dt>
          <dd class="mt-2 leading-relaxed text-ink-700">{resposta}</dd>
        </div>
      ))}
    </dl>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="mt-24">
    <PromoBanner />
  </div>
</PremiumLayout>

<script>
  const ACTIVE = ['bg-brand-600', 'text-white'];
  const IDLE = ['bg-white', 'text-brand-700'];

  const group = document.querySelector<HTMLElement>('[data-filter-group]');
  const cards = document.querySelectorAll<HTMLElement>('[data-grid] > [data-tema]');

  group?.addEventListener('click', event => {
    const btn = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-filter]');
    if (!btn) return;
    const filter = btn.dataset.filter!;

    group.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach(b => {
      const on = b === btn;
      b.setAttribute('aria-pressed', String(on));
      b.classList.remove(...(on ? IDLE : ACTIVE));
      b.classList.add(...(on ? ACTIVE : IDLE));
    });
    cards.forEach(card => {
      card.hidden = filter !== 'all' && card.dataset.tema !== filter;
    });
  });
</script>
